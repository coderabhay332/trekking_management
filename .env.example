# Copy to .env and adjust. .env is git-ignored.

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Defaults to backend/tma.db when empty
DATABASE_URL=

# Seeded once on first start
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@tma.com
ADMIN_PASSWORD=Admin@123

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_TTL=120

# SMTP (MailHog default: localhost:1025, no login)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@tma.local

# Optional Google Chat webhook for reminders
GCHAT_WEBHOOK_URL=
